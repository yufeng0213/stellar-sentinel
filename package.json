{
  "name": "stellar-sentinel",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "description": "星穹哨向 · 星际哨兵向导 RPG",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "npm run test:core && npm run test:combat && npm run test:npc && npm run test:llm && npm run test:world && npm run test:chargen && npm run test:tags && npm run test:events && npm run test:lore && npm run test:narrative",
    "test:core": "node tests/core-smoke.mjs",
    "test:combat": "node tests/combat-smoke.mjs",
    "test:npc": "node tests/npc-smoke.mjs",
    "test:llm": "node tests/llm-smoke.mjs",
    "test:world": "node tests/world-smoke.mjs",
    "test:chargen": "node tests/chargen-smoke.mjs",
    "test:tags": "node tests/tags-smoke.mjs",
    "test:events": "node tests/events-smoke.mjs",
    "test:lore": "node tests/lore-smoke.mjs",
    "test:narrative": "node tests/narrative-smoke.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
